# CareRoute Environment Configuration
# API Keys & Cloud Settings (Never commit real secrets)

# Google Gemini API Key (or use GCP Secret Manager in production)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Project Configuration
GCP_PROJECT_ID=careroute-prod
GCP_REGION=us-central1
GCP_SECRET_NAME=careroute-gemini-api-key

# Firestore Persistence Mode: 'firestore' (production) or 'emulator' / 'in_memory' (local dev/testing)
CAREROUTE_STORAGE_BACKEND=in_memory
FIRESTORE_DATABASE_ID=(default)

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=careroute-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# Logging & Environment
LOG_LEVEL=INFO
CAREROUTE_ENV=development

